# Copy to .env and adjust. .env is gitignored.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=supervalu
POSTGRES_USER=supervalu
POSTGRES_PASSWORD=supervalu
# Host-side port for psql/GUI access. 5433 avoids clashing with a local Postgres.
POSTGRES_PORT=5433

# --- Django ---------------------------------------------------------------
# Generate a real one (alphanumeric only — Docker Compose interpolates `$` in
# .env values, which would silently corrupt the key):
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(64)))"
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Europe/Dublin
BACKEND_PORT=8000

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Enables /setup-admin, which creates an admin account for whoever presents this
# code. Unset it once the first admin exists — while it is set, anyone with the
# code can create an admin. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_BOOTSTRAP_CODE=
ADMIN_BOOTSTRAP_RATE=5/hour

# --- CORS / CSRF ----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend -------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api

# --- Build targets (dev | prod) -------------------------------------------
BACKEND_TARGET=dev
FRONTEND_TARGET=dev

# --- Production only (see DEPLOYMENT.md) -----------------------------------
# Uploads directory. On Railway point this at a mounted volume, or every photo
# and signature is lost on redeploy.
# DJANGO_MEDIA_ROOT=/data/media
# Set False to smoke-test the prod target locally over plain http.
# SECURE_SSL_REDIRECT=True
# Origin the frontend's nginx proxies the API to.
# BACKEND_ORIGIN=https://your-backend.up.railway.app
